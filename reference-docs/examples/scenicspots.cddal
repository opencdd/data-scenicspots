# =============================================================================
# Grade-conditional property
#
# inscription_year applies only to spots whose official_grade selects the
# WorldHeritage extended instance — the same CONDITION_DET pattern
# OceanRunner uses for operating modes.
# =============================================================================

instance inscription_year < MDC_C003 {
  code: SPB131
  preferred_name.en: "inscription year"
  preferred_name.zh-TW: "列入年份"
  definition.en: "calendar year in which the site was inscribed on the World Heritage List"
  property_data_element_type: CONDITION_DET
  definition_class: ScenicSpot
  data_type: REAL_TYPE
  condition: official_grade == WorldHeritage
}

# =============================================================================
# Configured subclasses — instance-of-instance used as a class
#
# BuddhistTemple is the Temple extended instance specialized by the
# ReligiousTradition selection. It inherits ScenicSpot's properties,
# Temple's type-specific properties, and resolves the conditional
# `tradition` property.
# =============================================================================

instance BuddhistTemple < MDC_C002 {
  code: SPA150
  preferred_name.en: "Buddhist Temple"
  preferred_name.zh-TW: "佛寺"
  preferred_name.ja: "仏寺"
  definition.en: "temple of the Buddhist tradition"
  superclass: Temple
  class_type: ITEM_CLASS
  sub_class_selection: { Buddhist }
}

instance TaoistTemple < MDC_C002 {
  code: SPA151
  preferred_name.en: "Taoist Temple"
  preferred_name.zh-TW: "道觀"
  definition.en: "temple of the Taoist tradition"
  superclass: Temple
  class_type: ITEM_CLASS
  sub_class_selection: { Taoist }
}

instance FolkTemple < MDC_C002 {
