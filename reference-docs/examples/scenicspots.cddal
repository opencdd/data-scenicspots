# =============================================================================
# Enumerations
# =============================================================================

instance admission_enum < MDC_C005 {
  code: SPE001
  preferred_name.en: "admission categories"
  definition.en: "enumeration of whether entry to the spot requires payment"
  enumerated_values: { Free, Paid }
}

instance heritage_criteria_enum < MDC_C005 {
  code: SPE005
  preferred_name.en: "heritage listing criteria categories"
  definition.en: "enumeration of the World Heritage listing characters"
  enumerated_values: { Cultural, Natural, Mixed }
}

instance period_enum < MDC_C005 {
  code: SPE002
  preferred_name.en: "opening period categories"
  definition.en: "enumeration of whether the spot operates year-round or seasonally"
  enumerated_values: { YearRound, Seasonal }
}

instance mineral_enum < MDC_C005 {
  code: SPE003
  preferred_name.en: "mineral type categories"
  definition.en: "enumeration of the dominant dissolved mineral character of a hot spring"
  enumerated_values: { Sodium_bicarbonate, Sulfate, Carbonate, Iron }
}

instance excavation_enum < MDC_C005 {
  code: SPE004
  preferred_name.en: "excavation status categories"
  definition.en: "enumeration of the state of archaeological investigation of a site"
  enumerated_values: { Ongoing, Completed }
}

# =============================================================================
# Core properties (defined on ScenicSpot)
# =============================================================================

instance country < MDC_C003 {
  code: SPB001
  preferred_name.en: "country"
  preferred_name.zh-TW: "所在國家"
  definition.en: "sovereign state in which the scenic spot is located"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: CLASS_REFERENCE(Country)
}

instance spot_type < MDC_C003 {
  code: SPB002
  preferred_name.en: "scenic spot type"
  preferred_name.zh-TW: "景點類型"
  definition.en: "kind of scenic spot, selected from the scenic spot type classification"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: CLASS_REFERENCE(ScenicSpotType)
}

instance tradition < MDC_C003 {
  code: SPB003
  preferred_name.en: "religious tradition"
  preferred_name.zh-TW: "宗教傳統"
  definition.en: "religious tradition observed at the place of worship"
  property_data_element_type: CONDITION_DET
  definition_class: ScenicSpot
  data_type: CLASS_REFERENCE(ReligiousTradition)
  condition: spot_type == Temple
}

instance official_grade < MDC_C003 {
  code: SPB004
  preferred_name.en: "official grade"
  preferred_name.zh-TW: "官方等級"
  definition.en: "official listing or priority level of the scenic spot"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: CLASS_REFERENCE(OfficialGrade)
}

instance elevation < MDC_C003 {
  code: SPB005
  preferred_name.en: "elevation"
  preferred_name.zh-TW: "海拔"
  definition.en: "elevation above sea level of the spot's principal feature"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: REAL_TYPE
  unit: metre
}

instance latitude < MDC_C003 {
  code: SPB216
  preferred_name.en: "latitude"
  preferred_name.zh-TW: "緯度"
  definition.en: "north-south position of the spot's principal feature in decimal degrees (WGS 84)"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: REAL_TYPE
  unit: degree
}

instance longitude < MDC_C003 {
  code: SPB217
  preferred_name.en: "longitude"
  preferred_name.zh-TW: "經度"
  definition.en: "east-west position of the spot's principal feature in decimal degrees (WGS 84)"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: REAL_TYPE
  unit: degree
}

instance city < MDC_C003 {
  code: SPB218
  preferred_name.en: "city"
  preferred_name.zh-TW: "城市"
  definition.en: "city in which the spot is located, between the country and the spot itself"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: CLASS_REFERENCE(City)
}

instance visitor_data_year < MDC_C003 {
  code: SPB219
  preferred_name.en: "visitor data year"
  preferred_name.zh-TW: "遊客統計年份"
  definition.en: "reference year of the annual_visitors figure, when the source states it"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: INTEGER_TYPE
}

instance area < MDC_C003 {
  code: SPB006
  preferred_name.en: "area"
  preferred_name.zh-TW: "面積"
  definition.en: "extent of the scenic spot"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: REAL_TYPE
  unit: square_kilometre
}

instance established_year < MDC_C003 {
  code: SPB007
  preferred_name.en: "established year"
  preferred_name.zh-TW: "建立年份"
  definition.en: "calendar year in which the spot was established, constructed, or first recorded"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: REAL_TYPE
}

instance admission < MDC_C003 {
  code: SPB008
  preferred_name.en: "admission"
  preferred_name.zh-TW: "門票"
  definition.en: "whether entry requires payment"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: ENUM_STRING_TYPE(admission_enum)
}

instance opening_period < MDC_C003 {
  code: SPB009
  preferred_name.en: "opening period"
  preferred_name.zh-TW: "開放期間"
  definition.en: "operating period of the spot"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: ScenicSpot
  data_type: ENUM_STRING_TYPE(period_enum)
}

# =============================================================================
# Type-specific properties — defined ON the extended instances
#
# These properties exist only because their definition_class is an
# instance of a CATEGORICAL_CLASS: an instance that owns class-level
# facts. This is the capability UML cannot express.
# =============================================================================

instance trail_count < MDC_C003 {
  code: SPB101
  preferred_name.en: "trail count"
  preferred_name.zh-TW: "步道數量"
