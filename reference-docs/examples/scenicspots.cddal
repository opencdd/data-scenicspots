# =============================================================================
# Powertype 1 — ScenicSpotType
#
# Each member is an EXTENDED INSTANCE: it is selectable as the value of the
# spot_type CLASS_REFERENCE property AND is a class in its own right that
# carries its own applicable_properties and can be subclassed.
#
#   ScenicSpotType (CATEGORICAL_CLASS)
#   ├── NationalPark       ⇒ trail_count
#   ├── Temple             ⇒ founding_dynasty, deity  (+ tradition dimension)
#   ├── Palace             ⇒ royal_dynasty
#   ├── Museum             ⇒ collection_size
#   ├── HotSpring          ⇒ water_temperature, mineral_type
#   ├── NightMarket        ⇒ stall_count
#   ├── Mountain           ⇒ prominence
#   ├── Lake               ⇒ max_depth
#   └── ArchaeologicalSite ⇒ excavation_status
# =============================================================================

instance ScenicSpotType < MDC_C002 {
  code: SPA100
  preferred_name.en: "Scenic Spot Type"
  preferred_name.zh-TW: "景點類型"
  definition.en: "categorical class whose subclasses enumerate the kinds of scenic spots"
  superclass: ScenicSpot
  class_type: CATEGORICAL_CLASS
}

instance NationalPark < MDC_C002 {
  code: SPA101
  preferred_name.en: "National Park"
  preferred_name.zh-TW: "國家公園"
  preferred_name.ja: "国立公園"
  preferred_name.ko: "국립공원"
  definition.en: "protected area designated for conservation and public enjoyment by national law"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { trail_count, trail_length, wildlife_species }
}

instance Temple < MDC_C002 {
  code: SPA102
  preferred_name.en: "Temple"
  preferred_name.zh-TW: "寺廟"
  preferred_name.ja: "寺"
  preferred_name.ko: "사원"
  definition.en: "building dedicated to religious worship"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { founding_dynasty, deity, treasure_count }
}

instance Palace < MDC_C002 {
  code: SPA103
  preferred_name.en: "Palace"
  preferred_name.zh-TW: "宮殿"
  preferred_name.ko: "궁궐"
  definition.en: "grand residence of a sovereign or aristocratic family"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { royal_dynasty, floor_area, room_count }
}

instance Museum < MDC_C002 {
  code: SPA104
  preferred_name.en: "Museum"
  preferred_name.zh-TW: "博物館"
  preferred_name.ja: "博物館"
  preferred_name.ko: "박물관"
  preferred_name.it: "Museo"
  definition.en: "institution that cares for and displays a collection of artifacts"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { collection_size, exhibition_area, special_exhibition_count }
}

instance HotSpring < MDC_C002 {
  code: SPA105
  preferred_name.en: "Hot Spring"
  preferred_name.zh-TW: "溫泉"
  preferred_name.ja: "温泉"
  preferred_name.ko: "온천"
  definition.en: "natural spring of geothermally heated water"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { water_temperature, mineral_type, flow_rate, source_depth }
}

instance NightMarket < MDC_C002 {
  code: SPA106
  preferred_name.en: "Night Market"
  preferred_name.zh-TW: "夜市"
  preferred_name.ko: "야시장"
  definition.en: "street market operating primarily in the evening"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { stall_count, opening_days_per_week }
}

instance Mountain < MDC_C002 {
  code: SPA107
  preferred_name.en: "Mountain"
  preferred_name.zh-TW: "山岳"
  preferred_name.ja: "山"
  preferred_name.ko: "산"
  definition.en: "elevated landform rising prominently above its surroundings"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { prominence, first_ascent_year, climbing_routes }
}

instance Lake < MDC_C002 {
  code: SPA108
  preferred_name.en: "Lake"
  preferred_name.zh-TW: "湖泊"
  preferred_name.ja: "湖"
  definition.en: "inland body of standing water"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { max_depth, surface_area, mean_depth }
}

instance ArchaeologicalSite < MDC_C002 {
  code: SPA109
  preferred_name.en: "Archaeological Site"
  preferred_name.zh-TW: "考古遺址"
  preferred_name.it: "Sito Archeologico"
  definition.en: "place with physical evidence of past human activity studied by archaeology"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { excavation_status, discovery_year }
}

instance Landmark < MDC_C002 {
  code: SPA110
  preferred_name.en: "Landmark"
  preferred_name.zh-TW: "地標"
  definition.en: "structure or monument of recognized cultural, historical, or symbolic significance"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { architectural_style }
}

instance Cathedral < MDC_C002 {
  code: SPA111
  preferred_name.en: "Cathedral"
  preferred_name.zh-TW: "大教堂"
  preferred_name.ja: "大聖堂"
  preferred_name.ko: "성당"
  preferred_name.fr: "Cathédrale"
  preferred_name.es: "Catedral"
  definition.en: "principal church of a diocese, or a large historic church building of note"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { architectural_style }
}

instance Mosque < MDC_C002 {
  code: SPA112
  preferred_name.en: "Mosque"
  preferred_name.zh-TW: "清真寺"
  preferred_name.ja: "モスク"
  preferred_name.ko: "모스크"
  preferred_name.ms: "Masjid"
  definition.en: "place of worship for followers of Islam"
  superclass: ScenicSpotType
  class_type: ITEM_CLASS
  applicable_properties: { architectural_style }
}

# =============================================================================
# Powertype 2 — ReligiousTradition (conditional dimension)
#
# Applies only when spot_type == Temple; see the CONDITION_DET property
# `tradition` below. Combined with Temple via sub_class_selection this
# produces instance-of-instance classes (BuddhistTemple).
# =============================================================================

instance ReligiousTradition < MDC_C002 {
  code: SPA120
  preferred_name.en: "Religious Tradition"
  preferred_name.zh-TW: "宗教傳統"
  definition.en: "categorical class whose subclasses enumerate the religious traditions of a place of worship"
  superclass: ScenicSpot
  class_type: CATEGORICAL_CLASS
}

instance Buddhist < MDC_C002 {
  code: SPA121
  preferred_name.en: "Buddhist"
  preferred_name.zh-TW: "佛寺"
  preferred_name.ja: "仏寺"
  preferred_name.ko: "불교 사원"
  definition.en: "Buddhist tradition of worship"
  superclass: ReligiousTradition
  class_type: ITEM_CLASS
}

instance Taoist < MDC_C002 {
  code: SPA122
  preferred_name.en: "Taoist"
  preferred_name.zh-TW: "道觀"
  definition.en: "Taoist tradition of worship"
  superclass: ReligiousTradition
  class_type: ITEM_CLASS
}

instance FolkShrine < MDC_C002 {
  code: SPA123
  preferred_name.en: "Folk Shrine"
  preferred_name.zh-TW: "民間信仰廟宇"
  definition.en: "local folk-religion tradition of worship"
  superclass: ReligiousTradition
  class_type: ITEM_CLASS
}

instance Shinto < MDC_C002 {
  code: SPA124
  preferred_name.en: "Shinto"
  preferred_name.ja: "神道"
  definition.en: "indigenous Japanese tradition of worship at shrines"
  superclass: ReligiousTradition
  class_type: ITEM_CLASS
}

# =============================================================================
# Powertype 3 — OfficialGrade (priority / listing level)
#
# The user-facing "priority" of a spot: world heritage listing, national
# designation, and so on. WorldHeritage is itself an extended instance
# carrying inscription_year.
# =============================================================================

instance OfficialGrade < MDC_C002 {
  code: SPA130
  preferred_name.en: "Official Grade"
  preferred_name.zh-TW: "官方等級"
  definition.en: "categorical class whose subclasses enumerate the official listing or priority levels of a scenic spot"
  superclass: ScenicSpot
  class_type: CATEGORICAL_CLASS
}

instance WorldHeritage < MDC_C002 {
  code: SPA131
  preferred_name.en: "World Heritage"
  preferred_name.zh-TW: "世界遺產"
  preferred_name.ja: "世界遺産"
  preferred_name.ko: "세계유산"
  preferred_name.it: "Patrimonio Mondiale"
  definition.en: "site inscribed on the UNESCO World Heritage List"
  superclass: OfficialGrade
  class_type: ITEM_CLASS
  applicable_properties: { inscription_year }
}

instance NationalGrade < MDC_C002 {
  code: SPA132
  preferred_name.en: "National Grade"
  preferred_name.zh-TW: "國家級"
  preferred_name.ja: "国指定"
  definition.en: "designation of national significance"
  superclass: OfficialGrade
  class_type: ITEM_CLASS
}

instance ProvincialGrade < MDC_C002 {
  code: SPA133
  preferred_name.en: "Provincial Grade"
  preferred_name.zh-TW: "省市級"
  definition.en: "designation of provincial or municipal significance"
  superclass: OfficialGrade
  class_type: ITEM_CLASS
}

instance LocalGrade < MDC_C002 {
  code: SPA134
  preferred_name.en: "Local Grade"
  preferred_name.zh-TW: "地方級"
  definition.en: "designation of local significance"
  superclass: OfficialGrade
  class_type: ITEM_CLASS
}

# =============================================================================
